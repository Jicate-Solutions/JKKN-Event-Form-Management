# @boobalan_jkkn/bug-reporter-sdk@1.3.2 declares a peer of
#   lucide-react@^0.400.0 || ^0.500.0 || ^0.552.0
# but this app is on lucide-react 0.475.0, which none of those ranges include
# (a caret on a 0.x version pins the minor). Without this flag `npm install`
# fails with ERESOLVE, which would break the Vercel build, not just local setup.
#
# Checked rather than assumed: the SDK imports 20 icons from lucide (Bug,
# Camera, X, AlertCircle, Sparkles, Palette, Zap, Shield, FileText,
# ChevronDown, ChevronUp, Paperclip, ExternalLink, Filter, Trophy, Medal,
# Award, TrendingUp, Calendar, Gift) and all 20 exist in 0.475.0.
# Adding the SDK with this flag on added only the SDK and its @boobalan_jkkn/shared
# dependency to package-lock.json; no other package version changed.
#
# Same setting LoopMind and elevar-erp use for the same SDK. Remove it once the
# SDK publishes a peer range that includes the lucide-react version used here.
legacy-peer-deps=true
